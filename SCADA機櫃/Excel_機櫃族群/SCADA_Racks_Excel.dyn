    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "D:\\SCADA_主題導覽\\01_BIM model\\SCADA_機櫃_Dynamo\\Excel_機櫃族群\\族群",
      "Id": "9cc920f272d9406babee99e626a0cae2",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "acfbf11ea0eb4a5bad27c66fe7c2945d",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
